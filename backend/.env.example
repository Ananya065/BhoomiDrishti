# ============================================
# BhoomiDrishti Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to version control.

# --- GIS Data ---
# Absolute path recommended for local development.
# Example (Windows):
#   GIS_DATA_ROOT=C:/Users/adity/OneDrive/Desktop/bhoomidrishti/backend/data/gis
# Example (Linux/Docker):
#   GIS_DATA_ROOT=/app/data/gis
GIS_DATA_ROOT=data/gis

# Optional: override individual GIS layer filenames
# PROTECTED_AREA_LAYER=india_protected_areas.geojson
# WATER_LAYER=all_india_water.geojson
# FOREST_LAYER=forest.geojson

# --- Dataset ---
OSCD_DATASET_ROOT=/data/oscd

# --- CLIP Classification ---
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLASSIFICATION_HIGH_THRESHOLD=0.6
CLASSIFICATION_MEDIUM_THRESHOLD=0.4

# --- Groq Copilot (optional) ---
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Sentinel-2 Model Checkpoint ---
# SENTINEL2_MODEL_CHECKPOINT_PATH=ml/models/best_model.pth

# --- LISS-4 Model Checkpoint (optional) ---
# LISS4_MODEL_CHECKPOINT_PATH=
